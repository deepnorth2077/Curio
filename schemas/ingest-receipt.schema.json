{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deepnorth2077/curio/schemas/ingest-receipt.schema.json",
  "title": "ingest-receipt/1 · 摄入收据",
  "description": "事件落地时由内核写下的收据（规格第 5.3 节）。batch_id 与 clock_skew_ms 是否出现由 source 决定：local 两者都不能有；sync 两者都必须有（batch_id 是 syn_<ULID>）；import 必须有 batch_id（imp_<ULID>）但不能有 clock_skew_ms。",
  "type": "object",
  "required": ["event_id", "recorded_at", "source"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "$ref": "#/$defs/evtId" },
    "recorded_at": { "$ref": "#/$defs/timestamp" },
    "source": { "enum": ["local", "sync", "import"] },
    "batch_id": {
      "type": "string",
      "pattern": "^(syn|imp)_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "clock_skew_ms": { "type": "integer" }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "sync" } } },
      "then": {
        "required": ["batch_id", "clock_skew_ms"],
        "properties": { "batch_id": { "$ref": "#/$defs/synId" } }
      }
    },
    {
      "if": { "properties": { "source": { "const": "import" } } },
      "then": {
        "required": ["batch_id"],
        "not": { "required": ["clock_skew_ms"] },
        "properties": { "batch_id": { "$ref": "#/$defs/impId" } }
      }
    },
    {
      "if": { "properties": { "source": { "const": "local" } } },
      "then": {
        "not": { "anyOf": [{ "required": ["batch_id"] }, { "required": ["clock_skew_ms"] }] }
      }
    }
  ],
  "$defs": {
    "evtId": { "type": "string", "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "synId": { "type": "string", "pattern": "^syn_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "impId": { "type": "string", "pattern": "^imp_[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
